<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Terms of Service — Ownerdeck</title>
<meta name="description" content="Ownerdeck terms of service: EUR 150/month with no VAT, cancel any time with no notice period, what you are responsible for, and how liability is limited.">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<link rel="canonical" href="https://www.ownerdeck.com/terms.html">
<script>
/* Resolve theme before paint: saved choice, else OS preference. */
(function(){try{
  var s=localStorage.getItem('od_theme');
  var d=s?s:((window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light');
  document.documentElement.setAttribute('data-theme',d);
}catch(e){document.documentElement.setAttribute('data-theme','light');}})();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="icon" type="image/png" href="favicon.png">
<link rel="apple-touch-icon" href="favicon.png">
<meta name="theme-color" content="#ffffff">
<link rel="stylesheet" href="ds/tokens/typography.css">
<link rel="stylesheet" href="ds/tokens/colors.css">
<link rel="stylesheet" href="ds/tokens/spacing.css">
<link rel="stylesheet" href="ds/tokens/elevation.css">
<link rel="stylesheet" href="ds/tokens/base.css">
<link rel="stylesheet" href="ds/tokens/components.css">
<link rel="stylesheet" href="ds/styles.css">
<style>
:root{
  --accent:#01c0b8; --accent-strong:#097f7a; --accent-wash:#e6faf8; --accent-line:#a4f4ec;
  --paper:#f6f7f9; --ink:#0f1115; --ink-soft:#3d4448; --ink-mute:#6b7478; --ink-faint:#8b9497;
  --line:#e5e8ea; --line-soft:#eef0f2;
  --page:#ffffff; --card:#ffffff; --ink-fixed:#0f1115;
  --bg-app:#ffffff; --bg-raised:#f6f7f9; --surface-sunken:#eef0f2;
  --surface-card:#ffffff; --surface-hover:#f1f3f4; --surface:#f6f7f9;
  --text-strong:#0f1115; --text-body:#3d4448; --text-muted:#6b7478; --text-faint:#8b9497;
  --border:#e5e8ea; --border-soft:#eef0f2; --border-strong:#cfd5d7; --accent-text:#097f7a;
  color-scheme: light;
}
:root[data-theme="dark"]{
  color-scheme: dark;
  --page:#0a0e0f; --card:#121819; --paper:#0e1314;
  --bg-app:#0a0e0f; --bg-raised:#0e1314; --surface-sunken:#07090a;
  --ink:#eef4f4; --ink-soft:#c8d4d4; --ink-mute:#9fb0b2; --ink-faint:#6b7b7d;
  --line:#243032; --line-soft:#1b2426;
  --accent-strong:#38dccd; --accent-wash:rgba(1,192,184,.13); --accent-line:rgba(1,192,184,.32);
  --surface-card:#121819; --surface-hover:#1b2426; --surface:#0e1314;
  --text-strong:#eef4f4; --text-body:#c8d4d4; --text-muted:#9fb0b2; --text-faint:#6b7b7d;
  --border:#243032; --border-soft:#1b2426; --border-strong:#415052; --accent-text:#38dccd;
}
/* ---- Logo: monochrome lockup, swapped per theme ---- */
  .od-logo{display:block;width:auto;height:30px}
  .od-logo--onDark{display:none}
  :root[data-theme="dark"] .od-logo--onLight{display:none}
  :root[data-theme="dark"] .od-logo--onDark{display:block}
  @media (max-width:520px){ .od-logo{height:26px} }
body{margin:0;background:var(--page);color:var(--ink);font-family:var(--font-sans);-webkit-font-smoothing:antialiased}
h1,h2{margin:0;font-family:var(--font-display);font-weight:600;letter-spacing:-0.03em;color:var(--ink);text-wrap:balance}
p,li{margin:0;text-wrap:pretty}
a{color:var(--accent-strong);text-decoration:none}
a:hover{color:var(--ink)}
ul{margin:0;padding-left:20px}

header{position:sticky;top:0;z-index:50;border-bottom:1px solid transparent}
header::before{content:'';position:absolute;inset:0;pointer-events:none;background:color-mix(in srgb, var(--page) 84%, transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);opacity:0;transition:opacity .28s ease}
header > .bar{position:relative}
header.od-stuck::before{opacity:1}
header.od-stuck{border-bottom-color:var(--line)}
@media (prefers-reduced-motion: no-preference){
  header{transition:border-color .28s ease}
  ::view-transition-old(root),::view-transition-new(root){animation-duration:.32s;animation-timing-function:ease}
}
.bar{max-width:820px;margin:0 auto;padding:0 24px;height:68px;display:flex;align-items:center;gap:16px}
.brand{display:flex;align-items:center;gap:10px;flex:none}
.brand span{font-family:var(--font-display);font-size:19px;font-weight:600;letter-spacing:-0.035em;color:var(--ink)}
.brand .t{color:var(--accent-strong)}
.spacer{margin-left:auto}
.od-theme-btn{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;flex:none;padding:0;cursor:pointer;background:transparent;border:1px solid var(--line);border-radius:10px;color:var(--ink-mute);transition:color .18s ease,border-color .18s ease}
.od-theme-btn:hover{color:var(--ink);border-color:var(--border-strong)}
.od-theme-btn svg{width:17px;height:17px;display:block}
.od-theme-btn .ic-moon{display:none}
:root[data-theme="dark"] .od-theme-btn .ic-moon{display:block}
:root[data-theme="dark"] .od-theme-btn .ic-sun{display:none}

main{max-width:820px;margin:0 auto;padding:clamp(40px,6vw,72px) 24px clamp(64px,8vw,96px)}
.back{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:500;color:var(--ink-mute);margin-bottom:36px}
.back:hover{color:var(--ink)}
.eyebrow{font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mute);margin-bottom:16px}
.eyebrow .s{color:var(--accent-strong)}
h1{font-size:clamp(32px,4.4vw,46px);line-height:1.06}
.updated{margin-top:14px;font-size:14px;color:var(--ink-mute);font-family:var(--font-mono)}
.lede{margin-top:26px;font-size:17px;line-height:1.65;color:var(--ink-soft)}
h2{font-size:20px;line-height:1.3;margin:46px 0 14px}
p,li{font-size:15.5px;line-height:1.68;color:var(--ink-soft)}
p+p{margin-top:12px}
li{margin-bottom:8px}
.note{margin-top:40px;background:var(--accent-wash);border:1px solid var(--accent-line);border-radius:14px;padding:20px 22px;font-size:15px;line-height:1.6;color:var(--ink-soft)}
/* Unfilled legal details. Deliberately loud so they can't ship unnoticed. */
.todo{background:#ffe8a3;color:#5b4300;border-radius:4px;padding:1px 6px;font-family:var(--font-mono);font-size:13px}
.warn{margin-bottom:34px;background:#fff4d1;border:1px solid #e8c65c;border-radius:14px;padding:18px 20px;font-size:14.5px;line-height:1.6;color:#5b4300}

footer{border-top:1px solid var(--line);background:var(--paper)}
.foot{max-width:820px;margin:0 auto;padding:28px 24px;display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;font-size:14px;color:var(--ink-mute)}
</style>
</head>
<body>

<header>
  <div class="bar">
    <a href="/" class="brand" aria-label="Ownerdeck home">
      <img class="od-logo od-logo--onLight" src="logo-lockup-dark.png" alt="OwnerDeck" width="667" height="120"><img class="od-logo od-logo--onDark" src="logo-lockup-light.png" alt="" aria-hidden="true" width="667" height="120">
    </a>
    <div class="spacer"></div>
    <button id="theme-toggle" type="button" class="od-theme-btn" aria-label="Switch to dark mode" aria-pressed="false" title="Toggle dark mode">
      <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
    </button>
    <a href="/" class="od-btn od-btn--secondary" style="text-decoration:none">Back to site</a>
  </div>
</header>

